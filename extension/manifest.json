{
  "manifest_version": 3,
  "name": "BetterTabs: Side Panel Tab Manager",
  "version": "1.7.1",
  "description": "Tab manager in Chrome's side panel: group tabs by site, search, suspend and save them. Private, no account.",
  "homepage_url": "https://github.com/MXmaster2s/BetterTabs",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "tabGroups", "sidePanel", "storage", "favicon"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Open BetterTabs"
    },
    "search-tabs": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open BetterTabs and search your tabs"
    }
  },
  "action": {
    "default_title": "Open BetterTabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
