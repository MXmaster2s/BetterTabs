{
  "manifest_version": 3,
  "name": "BetterTabs",
  "version": "1.2.1",
  "description": "All your open tabs in Chrome's side panel, grouped by website.",
  "homepage_url": "https://github.com/MXmaster2s/BetterTabs",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "tabGroups", "sidePanel", "storage", "favicon"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open BetterTabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
